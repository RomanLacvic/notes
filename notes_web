import json
from PyQt5.QtCore import Qt
from PyQt5.QtWidgets import QApplication, QWidget, QPushButton, QLabel, QListWidget, QLineEdit, QTextEdit, QInputDialog, QHBoxLayout, QVBoxLayout, QFormLayout
app=QApplication([])
main_win=QWidget()
text=QTextEdit()
list_text=QLabel('Список заметок')
w_list=QListWidget()
create_note=QPushButton('Создать заметку')
remove_note=QPushButton('Удалить заметку')
save_note=QPushButton('Сохранить заметку')
tags_text=QLabel('Список тегов')
list_tag=QListWidget()
enter_tag=QLineEdit()
enter_tag.setPlaceholderText('Введите тег...')
add_to_note=QPushButton('Добавить к заметке')
remove_from_note=QPushButton('Открепить от заметки')
search_tag=QPushButton('Искать по тегу')

H_line1=QHBoxLayout()
H_line1.addWidget(create_note)
H_line1.addWidget(remove_note)
H_line2=QHBoxLayout()
H_line2.addWidget(save_note)
H_line3=QHBoxLayout()
H_line3.addWidget(add_to_note)
H_line3.addWidget(remove_from_note)
H_line4=QHBoxLayout()
H_line4.addWidget(search_tag)

V_line1=QVBoxLayout()
V_line1.addWidget(text)
V_line2=QVBoxLayout()
V_line2.addWidget(list_text)
V_line2.addWidget(w_list)
V_line2.addLayout(H_line1)
V_line2.addLayout(H_line2)
V_line2.addWidget(tags_text)
V_line2.addWidget(list_tag)
V_line2.addWidget(enter_tag)
V_line2.addLayout(H_line3)
V_line2.addLayout(H_line4)

H_main=QHBoxLayout()
H_main.addLayout(V_line1)
H_main.addLayout(V_line2)
main_win.setLayout(H_main)
